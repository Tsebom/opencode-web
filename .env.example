# --- OpenCode Server Settings ---
# Port the server will listen on
OPENCODE_PORT=4096
# Password for Web UI and API authentication
# If left empty, a random password will be generated and printed in the logs
OPENCODE_PASSWORD=your-secret-password-here

# --- API Keys ---
# These keys are used by the models configured in opencode.jsonc
WORMSOFT_API_KEY=your-wormsoft-key-here
POLZA_API_KEY=your-polza-key-here
# These keys are used by MCP servers configured in opencode.jsonc
CONTEXT7_API_KEY=your-context7-key-here
